// JupyterLab keyboard overrides for presenting CS0002 lectures.
//
// Shift+Enter runs the active cell without selecting the next cell, so RISE
// stays on the current slide while its output appears. Disabling JupyterLab's
// command-mode Left/Right bindings lets reveal.js advance exactly one slide.
{
  "shortcuts": [
    {
      "command": "notebook:move-cursor-heading-below-or-expand",
      "keys": ["ArrowRight"],
      "selector": ".jp-Notebook.jp-mod-commandMode:not(.jp-mod-readWrite) :focus",
      "disabled": true
    },
    {
      "command": "notebook:move-cursor-heading-above-or-collapse",
      "keys": ["ArrowLeft"],
      "selector": ".jp-Notebook.jp-mod-commandMode:not(.jp-mod-readWrite) :focus",
      "disabled": true
    },
    {
      "command": "notebook:run-cell-and-select-next",
      "keys": ["Shift Enter"],
      "selector": ".jp-Notebook.jp-mod-editMode",
      "disabled": true
    },
    {
      "command": "notebook:run-cell",
      "keys": ["Shift Enter"],
      "selector": ".jp-Notebook.jp-mod-editMode"
    },
    {
      "command": "notebook:run-cell",
      "keys": ["Shift Enter"],
      "selector": ".jp-Notebook.jp-mod-commandMode:not(.jp-mod-readWrite) :focus"
    }
  ]
}
