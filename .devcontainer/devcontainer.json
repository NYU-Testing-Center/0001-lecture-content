{
  "name": "CS0002 Lectures — JupyterLab + RISE",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteEnv": {
    "JUPYTER_PATH": "${containerWorkspaceFolder}/tools/jupyter-data"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/start-jupyter.sh",
  "forwardPorts": [
    8888
  ],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab (RISE)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "remoteUser": "vscode"
}
